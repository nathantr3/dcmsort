#!/bin/sh
# dcmsort command line entry point, shipped inside the .app bundle.
#
# The bundle already carries a complete Node runtime: its own Electron binary,
# which runs any script as plain Node when ELECTRON_RUN_AS_NODE is set. So the
# CLI needs no second runtime and can never drift from the app it ships with.
#
# Symlink this into your PATH, e.g.
#   ln -s "/Applications/dcmsort.app/Contents/Resources/dcmsort" /usr/local/bin/dcmsort

set -e

# Resolve through symlinks so a link in /usr/local/bin still finds the bundle.
SELF=$0
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF")
    case $LINK in
        /*) SELF=$LINK ;;
        *) SELF=$(dirname "$SELF")/$LINK ;;
    esac
done
HERE=$(cd "$(dirname "$SELF")" && pwd)

ELECTRON_RUN_AS_NODE=1 export ELECTRON_RUN_AS_NODE
exec "$HERE/../MacOS/dcmsort" "$HERE/app.asar/src/cli/cli.js" "$@"
